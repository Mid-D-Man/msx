// .mdix/replacements/replacements.mdix
// Drops the msx-anim resolver (Phase 2), animations::/duration/loop_mode
// DixScript parsing (Phase 3, parser half), the msx-cli `animate` GIF
// subcommand, the Pages-report animation wiring, mixed SDF+splat
// animation tests, and the Def::Shader embedding (external .wgsl
// reference + binary codec + safe non-executing fallbacks) — everything
// built across this conversation, all in one drop.
//
// Every other file in this folder sits at its real target path already
// (core/msx-anim/src/lib.rs etc.) — nested paths resolve directly under
// target_root, no search, no ambiguity, which is exactly why this was
// worth doing over hand-copying: this file set has THREE lib.rs files,
// TWO gradient.rs files, and several Cargo.toml files, all of which would
// be genuinely ambiguous under plain basename search.

@CONFIG(
  version    -> "1.0.0"
  author     -> "MidManStudio"
  
  debug_mode -> "off"
)

@QUICKFUNCS(
  ~target<object>(name, path) { return { name = name, path = path } }
)

@DATA(
  target_root = "."
overrides::
  target("Cargo.toml", "./Cargo.toml")
  
)
