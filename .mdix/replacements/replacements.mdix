// .mdix/replacements/replacements.mdix
//
// v8: clip paths on layers, importer clip-path and viewport clipping,
// animation warnings. Requires v7 (already applied).
//
// - msx-ast: Layer gains clip_path (None, or the shapes whose union stays
//   visible). msx-parser reads and writes it. msx-binary stores it behind a
//   spare bit of the existing clip byte, so older files decode unchanged and
//   the version byte stays at 2.
// - msx-render-svg writes a clipPath element, msx-render-cpu builds an
//   antialiased coverage mask, msx-render-gpu draws a mask texture and
//   multiplies the layer with it.
// - msx-svg-import turns clip-path url(#id) into layers (both units, clip-rule,
//   transform, nested clips), clips symbol and nested svg to their viewport
//   unless overflow is visible, honors a use width or height on a nested svg
//   per axis, and warns for SMIL and CSS animations.
// - docs: layers page, svg-import, svg-parity, backends table.
//
// No root Cargo.toml in this drop, so the override below is unused.

@CONFIG(
  version    -> "1.0.0"
  author     -> "MidManStudio"

  debug_mode -> "off"
)

@QUICKFUNCS(
  ~target<object>(name, path) { return { name = name, path = path } }
)

@DATA(
  target_root = "."

  overrides::
    target("ROOT_Cargo.toml", "./Cargo.toml")
)
