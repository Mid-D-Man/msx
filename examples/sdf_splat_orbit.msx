// examples/sdf_splat_orbit.msx
// Animated companion to sdf_splat_mixed.msx — same "hard SDF shape + soft
// splat glow" language, but now the splat bloom actually breathes in sync
// with the SDF blob's pulse, and a second splat drifts past behind it.
// Exercises msx-anim on both composition paths (Transform-based SDF vs
// raw-field Splat) driven by tracks with different periods in one scene.
@CONFIG( version -> "1.0.0" )
@DATA(
  scene = { width = 500, height = 300, background = #080810 }
  duration = 1.4
  loop_mode = "ping_pong"
  elements::

    // Slow drifting atmosphere, furthest back.
    { type = "splat", id = "glow_drift", x = 120, y = 150,
      sigma_x = 140, sigma_y = 90, color = #0f1a40, opacity = 0.55 }

    // The SDF blob — two smooth-merged circles, breathing + slowly turning.
    { type = "sdf", id = "core_blob", fill = #e94560,
      transform = { type = "translate", x = 250, y = 150 },
      tree = { type = "smooth_union", k = 0.35,
        children = [ { type = "circle", cx = -20, cy = 0, r = 34 },
                     { type = "circle", cx =  20, cy = 0, r = 34 } ] } }

    // Tight bloom glued to the blob's center — bigger/brighter at the same
    // moment the blob is at its widest, so it reads as one glowing object.
    { type = "splat", id = "glow_bloom", x = 250, y = 150,
      sigma_x = 30, sigma_y = 30, color = #ff6b8a, opacity = 0.6 }
    { type = "splat", id = "glow_bloom_hot", x = 250, y = 150,
      sigma_x = 12, sigma_y = 12, color = #ffffff, opacity = 0.5 }

  animations::
    // Atmosphere drifts the full width, on its own slower rhythm.
    { target_id = "glow_drift", property = "translate_x",
      keyframes = [ { time = 0.0, value = -60.0 },
                    { time = 1.4, value = 60.0, easing = "ease_in_out" } ] }

    // Blob breathes (scale) and slowly turns (rotate).
    { target_id = "core_blob", property = "scale_x",
      keyframes = [ { time = 0.0, value = 1.0 },
                    { time = 0.7, value = 1.25, easing = "ease_out" } ] }
    { target_id = "core_blob", property = "scale_y",
      keyframes = [ { time = 0.0, value = 1.0 },
                    { time = 0.7, value = 1.25, easing = "ease_out" } ] }
    { target_id = "core_blob", property = "rotate",
      keyframes = [ { time = 0.0, value = 0.0 },
                    { time = 1.4, value = 20.0, easing = "ease_in_out" } ] }

    // Bloom grows and brightens in lockstep with the blob's scale peak.
    { target_id = "glow_bloom", property = "scale_x",
      keyframes = [ { time = 0.0, value = 1.0 },
                    { time = 0.7, value = 1.6, easing = "ease_out" } ] }
    { target_id = "glow_bloom", property = "scale_y",
      keyframes = [ { time = 0.0, value = 1.0 },
                    { time = 0.7, value = 1.6, easing = "ease_out" } ] }
    { target_id = "glow_bloom", property = "opacity",
      keyframes = [ { time = 0.0, value = 0.6 },
                    { time = 0.7, value = 0.9, easing = "ease_out" } ] }
    { target_id = "glow_bloom_hot", property = "scale_x",
      keyframes = [ { time = 0.0, value = 1.0 },
                    { time = 0.7, value = 1.8, easing = "ease_out" } ] }
    { target_id = "glow_bloom_hot", property = "scale_y",
      keyframes = [ { time = 0.0, value = 1.0 },
                    { time = 0.7, value = 1.8, easing = "ease_out" } ] }
)
