// examples/anim_dots_syncbase.msx
// Three dots that grow one after the other, from an SVG whose begin values name other
// animations (d1.begin+0.25s, d3.end+0.25s). The importer solves the chain: the dots
// start 0.25 s apart and the first starts again 0.25 s after the last ends, so the whole
// ring repeats every 1.55 s. The radius is a real channel (r), which makes the file wire
// version 3. Made from examples/svg/spinner_dots.svg with `msx import`.
@CONFIG( version -> "1.0.0" )
@DATA(
  scene = { width = 120, height = 48, background = "#00000000" }
  duration = 1.55
  loop_mode = "loop"
  elements::
    { type = "rect", x = 0, y = 0, width = 120, height = 48, style = { fill = #0f1220 } }
    { type = "circle", cx = 30, cy = 24, r = 0, id = "anim1", style = { fill = #4a9eff } }
    { type = "circle", cx = 60, cy = 24, r = 0, id = "anim2", style = { fill = #2ecc71 } }
    { type = "circle", cx = 90, cy = 24, r = 0, id = "anim3", style = { fill = #ffb84a } }
  animations::
    { target_id = "anim1", property = "r",
      keyframes = [
        { time = 0.0, value = 0.0 },
        { time = 0.4, value = 9.0 },
        { time = 0.8, value = 0.0 },
        { time = 0.801, value = 0.0 },
        { time = 1.55, value = 0.0 }
      ] }
    { target_id = "anim2", property = "r",
      keyframes = [
        { time = 0.0, value = 0.0 },
        { time = 0.249, value = 0.0 },
        { time = 0.25, value = 0.0 },
        { time = 0.65, value = 9.0 },
        { time = 1.05, value = 0.0 },
        { time = 1.051, value = 0.0 },
        { time = 1.55, value = 0.0 }
      ] }
    { target_id = "anim3", property = "r",
      keyframes = [
        { time = 0.0, value = 0.0 },
        { time = 0.499, value = 0.0 },
        { time = 0.5, value = 0.0 },
        { time = 0.9, value = 9.0 },
        { time = 1.3, value = 0.0 },
        { time = 1.301, value = 0.0 },
        { time = 1.55, value = 0.0 }
      ] }
)
