// examples/anim_set_and_steps.msx
// `set`, discrete `visibility` and CSS `steps()` after import. The blue rect appears
// at 1 s from `display: none`, the orange circle at 0.5 s from `visibility: hidden`,
// the red dot blinks, and the green bar fills in five jumps. Made from
// examples/svg/set_and_steps.svg with `msx import`. The scene loops every 2 s, so
// the things that appear once start again on each loop.
@CONFIG( version -> "1.0.0" )
@DATA(
  scene = { width = 240, height = 140, background = "#00000000" }
  duration = 2.0
  loop_mode = "loop"
  elements::
    { type = "rect", x = 0, y = 0, width = 240, height = 140, style = { fill = #0f1220 } }
    { type = "rect", x = 20, y = 104, width = 200, height = 12, rx = 2, ry = 2, style = { fill = #1d2540 } }
    { type = "group", transform = "translate(20 110)",
      elements = [
        { type = "group", id = "anim1",
          elements = [
            { type = "group", transform = "translate(-20 -110)",
              elements = [
                { type = "rect", x = 20, y = 104, width = 200, height = 12, rx = 2, ry = 2, style = { fill = #2ecc71 } }
              ] }
          ] }
      ] }
    { type = "layer", blend_mode = "normal", opacity = 1, id = "anim2",
      elements = [
        { type = "rect", x = 20, y = 20, width = 60, height = 40, style = { fill = #4a9eff } }
      ] }
    { type = "layer", blend_mode = "normal", opacity = 1, id = "anim3",
      elements = [
        { type = "circle", cx = 125, cy = 40, r = 18, style = { fill = #f7971e } }
      ] }
    { type = "layer", blend_mode = "normal", opacity = 1, id = "anim4",
      elements = [
        { type = "circle", cx = 190, cy = 40, r = 10, style = { fill = #e94560 } }
      ] }
  animations::
    { target_id = "anim1", property = "scale_x",
      keyframes = [
        { time = 0.0, value = 0.0001 },
        { time = 0.399, value = 0.0001 },
        { time = 0.4, value = 0.20008 },
        { time = 0.799, value = 0.20008 },
        { time = 0.8, value = 0.40006 },
        { time = 1.199, value = 0.40006 },
        { time = 1.2, value = 0.60004 },
        { time = 1.5990000000000002, value = 0.60004 },
        { time = 1.6, value = 0.8000200000000001 },
        { time = 1.999, value = 0.8000200000000001 },
        { time = 2.0, value = 1.0 }
      ] }
    { target_id = "anim2", property = "opacity",
      keyframes = [
        { time = 0.0, value = 0.0 },
        { time = 0.999, value = 0.0 },
        { time = 1.0, value = 1.0 },
        { time = 1.004, value = 1.0 }
      ] }
    { target_id = "anim3", property = "opacity",
      keyframes = [
        { time = 0.0, value = 0.0 },
        { time = 0.499, value = 0.0 },
        { time = 0.5, value = 1.0 },
        { time = 0.504, value = 1.0 }
      ] }
    { target_id = "anim4", property = "opacity",
      keyframes = [
        { time = 0.0, value = 1.0 },
        { time = 0.499, value = 1.0 },
        { time = 0.5, value = 0.0 },
        { time = 0.999, value = 0.0 },
        { time = 1.0, value = 1.0 },
        { time = 1.499, value = 1.0 },
        { time = 1.5, value = 0.0 },
        { time = 1.999, value = 0.0 },
        { time = 2.0, value = 1.0 }
      ] }
)
