// examples/anim_motion_path.msx
// `animateMotion` after import. The red arrow follows a curve with `rotate="auto"`, and
// the orange square ping-pongs along a line using keyPoints. Made from
// examples/svg/motion_path.svg with `msx import`: the paths are sampled into
// translate and rotate tracks, so the arrow turns smoothly with the curve.
@CONFIG( version -> "1.0.0" )
@DATA(
  scene = { width = 240, height = 140, background = "#00000000" }
  duration = 6.0
  loop_mode = "loop"
  elements::
    { type = "rect", x = 0, y = 0, width = 240, height = 140, style = { fill = #0f1220 } }
    { type = "path", d = "M 30 60 C 30 10 110 10 110 60 S 190 110 190 60 C 190 20 150 20 150 60", style = { fill = "none", stroke = #334155, stroke_width = 2 } }
    { type = "group", id = "anim1",
      elements = [
        { type = "path", d = "M -8 -8 L 12 0 L -8 8 L -3 0 Z", style = { fill = #f2545b } }
      ] }
    { type = "group", id = "anim2",
