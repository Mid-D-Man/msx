@CONFIG( version -> "1.0.0" )
@DATA(
  scene = { width = 640, height = 400, background = #14161f }
  defs::
    { type = "linear_gradient", id = "title_fill",
      x1 = 0.0, y1 = 0.0, x2 = 1.0, y2 = 0.0,
      stops = [
        { offset = 0.0, color = #f7971e, opacity = 1.0 },
        { offset = 1.0, color = #e94560, opacity = 1.0 }
      ] }
  elements::
    { type = "text", x = 320, y = 70, content = "MSX Text",
      style = { fill = "url(#title_fill)", font_size = 56, font_weight = "bold", text_anchor = "middle" } }
    { type = "text", x = 30, y = 125, content = "Regular: quick brown fox",
      style = { fill = #ffffff, font_size = 22 } }
    { type = "text", x = 30, y = 160, content = "Bold: quick brown fox",
      style = { fill = #ffffff, font_size = 22, font_weight = "bold" } }
    { type = "text", x = 360, y = 125, content = "Accents: é ñ ü ß Å",
      style = { fill = #4facfe, font_size = 22 } }
    { type = "text", x = 360, y = 160, content = "Weight 700, size 22",
      style = { fill = #4facfe, font_size = 22, font_weight = "700" } }
    { type = "line", x1 = 320, y1 = 195, x2 = 320, y2 = 295,
      style = { stroke = #555566, stroke_width = 1 } }
    { type = "text", x = 320, y = 220, content = "start",
      style = { fill = #ffd200, font_size = 22, text_anchor = "start" } }
    { type = "text", x = 320, y = 255, content = "middle",
      style = { fill = #ffd200, font_size = 22, text_anchor = "middle" } }
    { type = "text", x = 320, y = 290, content = "end",
      style = { fill = #ffd200, font_size = 22, text_anchor = "end" } }
    { type = "text", x = 30, y = 365, content = "Outline",
      style = { fill = "none", stroke = #e94560, stroke_width = 2, font_size = 72 } }
    { type = "text", x = 340, y = 365, content = "Gradient",
      style = { fill = "url(#title_fill)", font_size = 64 } }
)
